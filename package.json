{
  "name": "network-3d-viz",
  "version": "0.1.0",
  "description": "A React component for visualising a network of data points in 3D space using WebGL",
  "type": "module",
  "main": "./dist/network-3d-viz.umd.js",
  "module": "./dist/network-3d-viz.es.js",
  "exports": {
    ".": {
      "import": "./dist/network-3d-viz.es.js",
      "require": "./dist/network-3d-viz.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@react-three/drei": "^9.0.0",
    "@react-three/fiber": "^8.0.0",
    "d3-force-3d": "^3.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vite": "^5.0.0"
  }
}
